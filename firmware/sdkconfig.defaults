# Waveshare ESP32-C6-Touch-AMOLED-2.16 (16 MB flash, no PSRAM).
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

# Logs go to UART0 (the console) AND, on purpose, to USB-Serial-JTAG as the
# secondary console. UART0 is not wired to anything; over USB the host daemon
# relays the board's log lines to its own log (docs/protocol.md). Frames only
# flow host -> board, so board -> host log lines cannot corrupt them; the
# daemon skips any line that is not a JSON object.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# Wi-Fi and Bluetooth are unused in phase 1.
CONFIG_BT_ENABLED=n

# LVGL 9: RGB565 and its own heap. The UI's fonts are generated (main/fonts/);
# Montserrat 14 stays only as LVGL's default font.
CONFIG_LV_COLOR_DEPTH_16=y
# Far mode: a glyph of the 187 px digits needs an A8 buffer of about 16 KB
# on this heap while it draws.
CONFIG_LV_MEM_SIZE=98304
# The far-mode fonts are RLE-compressed (scripts/gen_fonts.py).
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_USE_LOG=n
CONFIG_LV_USE_DEMO_WIDGETS=n
CONFIG_LV_USE_DEMO_BENCHMARK=n

# Task watchdog: the LVGL task subscribes (ui.c, from its LVGL timer only). A hung UI panics and the
# board reboots, instead of freezing on a stale LIVE screen.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# Core dump to flash (partitions.csv), ELF with a checksum, so a crash can be
# read from the host: scripts/firmware.py coredump. The boot hello also
# carries the panic reason from it (serial_rx.c).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_SHA256=y
CONFIG_ESP_COREDUMP_CHECK_BOOT=y
