# dgx-status reads these. None is secret.

# The board's serial port.
# A path or a glob that matches exactly one port. Unset: the daemon looks for
# the one Espressif USB-Serial-JTAG port under /dev/serial/by-id/.
DGX_STATUS_DEVICE=/dev/serial/by-id/usb-Espressif_USB_JTAG_serial_debug_unit_*-if00

# Log level: DEBUG, INFO, WARNING or ERROR.
DGX_STATUS_LOG_LEVEL=INFO

# Network and storage tiles. Each is found automatically; set one only when
# the automatic choice is wrong.
# The LAN interface. Unset: the interface with the default route.
DGX_STATUS_LAN_IFACE=
# RDMA ports summed for RoCE, as device/port (a bare device means port 1).
# Unset: every /sys/class/infiniband port whose link layer is Ethernet.
DGX_STATUS_ROCE_PORTS=
# Interfaces summed for Cluster IP. Unset: every mlx5_core interface.
DGX_STATUS_CLUSTER_IFACES=
# The disk for SSD read and write, as in /sys/block (nvme0n1). Unset: the
# disk that holds DGX_STATUS_DISK_PATH.
DGX_STATUS_SSD_DISK=
# The path whose file system Disk used reports. Unset: /.
DGX_STATUS_DISK_PATH=/
